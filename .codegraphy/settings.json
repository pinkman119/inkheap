{
  "version": 1,
  "maxFiles": 1000,
  "include": [
    "**/*"
  ],
  "respectGitignore": true,
  "filterPatterns": [],
  "disabledCustomFilterPatterns": [],
  "nodeVisibility": {
    "symbol": true,
    "symbol:function": true,
    "symbol:namespace": true,
    "symbol:callable": true,
    "symbol:method": true,
    "symbol:constructor": true,
    "symbol:prototype": true,
    "symbol:class": true,
    "symbol:mixin": true,
    "symbol:extension": true,
    "symbol:interface": true,
    "symbol:record": true,
    "symbol:delegate": true,
    "symbol:property": true,
    "symbol:event": true,
    "symbol:type": true,
    "symbol:struct": true,
    "symbol:union": true,
    "symbol:enum": true,
    "symbol:typedef": true,
    "symbol:alias": true,
    "symbol:template": true,
    "variable": true,
    "variable:plain": true,
    "symbol:constant": true,
    "symbol:global": true,
    "symbol:field": true,
    "symbol:parameter": true,
    "symbol:local": true,
    "package": true
  },
  "edgeVisibility": {
    "call": true,
    "contains": true,
    "inherit": true,
    "implements": true,
    "overrides": true,
    "reference": true,
    "type-import": true,
    "include": true,
    "nests": true,
    "using": true,
    "event": true,
    "load": true,
    "type": true
  },
  "plugins": [
    {
      "id": "codegraphy.markdown",
      "activation": "inherit"
    }
  ],
  "interfaces": [],
  "pluginData": {}
}
