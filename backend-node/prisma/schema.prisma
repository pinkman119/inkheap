generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  password     String
  role         String    @default("admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")
  remark       String?
  status       String    @default("active")

  @@map("admin_users")
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String?
  content     String
  coverImage  String?  @map("cover_image")
  categoryKey String   @map("category_key")
  tags        String   @default("[]")
  author      String
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  viewCount   Int      @default(0) @map("view_count")
  type        String   @default("article") @map("type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  trainType   Int      @default(0) @map("train_type")

  @@map("articles")
}

model HomePage {
  id          String   @id @default("home")
  siteName    String   @default("INKHEAP") @map("site_name")
  personTitle String   @default("Digital Gardener & Lifelong Learner") @map("person_title")
  codeContent String   @default("") @map("code_content")
  avatar      String?  @map("avatar")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("home_page")
}

model File {
  id           String   @id @default(uuid())
  filename     String   @map("filename")
  originalName String?  @map("original_name")
  url          String   @unique @map("url")
  mimeType     String?  @map("mime_type")
  size         Int
  relativePath String   @map("relative_path")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("files")
}

model Resume {
  id        String   @id @default(uuid())
  name      String   @default("默认版本")
  content   String   @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trainType Int      @default(0) @map("train_type")

  @@map("resume")
}

model Category {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  parentKey String?  @map("parent_key")
  sortOrder Int      @default(0) @map("sort_order")
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Blog {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  type      String   @default("album")
  tags      String   @default("[]")
  content   String   @default("")
  summary   String?
  quote     String?
  location  String?
  date      String?
  photos    String   @default("[]")
  published Boolean  @default(false)
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trainType Int      @default(0) @map("train_type")

  @@map("blogs")
}

model BlogCategory {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blog_categories")
}

model AboutProfile {
  id              String   @id @default("about")
  kicker          String   @default("About Me")
  lede            String   @default("")
  evaluationQuote String   @default("") @map("evaluation_quote")
  evaluationBy    String   @default("") @map("evaluation_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  trainType       Int      @default(0) @map("train_type")

  @@map("about_profile")
}

model AboutFootprint {
  id        String   @id @default(uuid())
  province  String
  place     String
  time      String
  location  String
  note      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trainType Int      @default(0) @map("train_type")
  elevation String   @default("—")

  @@map("about_footprints")
}

model AboutTravel {
  id        String   @id @default(uuid())
  glyph     String
  place     String
  meta      String
  note      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trainType Int      @default(0) @map("train_type")

  @@map("about_travels")
}

model AboutEvent {
  id        String   @id @default(uuid())
  date      DateTime
  title     String
  desc      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  trainType Int      @default(0) @map("train_type")
  isRing    Boolean  @default(false) @map("is_ring")

  @@map("about_events")
}

model SiteVisit {
  id        String   @id @default(uuid())
  day       DateTime @unique
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_visits")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  phone     String?
  subject   String?  @map("subject")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  contact   String?  @map("contact")

  @@index([createdAt])
  @@map("contact_messages")
}

model WechatUser {
  id        String   @id @default(uuid())
  openid    String   @unique
  nickname  String   @default("微信用户")
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wechat_users")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model DlModel {
  id        String   @id @default(uuid())
  name      String
  provider  String
  modelId   String   @map("model_id")
  enabled   Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  apiKeyEnc String?  @map("api_key_enc")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  modelType String   @default("general") @map("type")

  @@map("dl_models")
}

model DlPersona {
  id              String   @id @default(uuid())
  name            String
  greeting        String   @default("")
  description     String   @default("")
  styleHint       String   @default("") @map("style_hint")
  accentColor     String   @default("#2d8264") @map("accent_color")
  avatarEmoji     String   @default("") @map("avatar_emoji")
  personalityType String   @default("") @map("personality_type")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dl_personas")
}

// dl_vectors 表由 prisma/pgvector-init.ts 与 VectorService 原生 SQL 管理，
// 此处仅保留定义以兼容 schema 自检（Prisma 不支持 vector 列）。
model dl_vectors {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ref_type    String
  ref_id      String
  chunk_index Int
  content     String
  embedding   Unsupported("vector")
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([ref_type, ref_id, chunk_index])
}

model FooterLink {
  id        String   @id @default(uuid())
  type      String
  mode      Int      @default(0)
  label     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, sortOrder])
  @@map("footer_links")
}
