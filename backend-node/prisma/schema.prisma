generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== Admin ====================

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ==================== 文章 ====================

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String?
  content     String
  coverImage  String?  @map("cover_image")
  categoryKey String   @map("category_key")
  tags        String   @default("[]")
  author      String
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

// ==================== 首页配置 ====================

model HomePage {
  id          String   @id @default("home") // 全局唯一的首页配置
  siteName    String   @default("INKHEAP") @map("site_name") // 首页名称
  personTitle String   @default("Digital Gardener & Lifelong Learner") @map("person_title") // 首页人物 title
  codeContent String   @default("") @map("code_content") // 首页代码框内容
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("home_page")
}

// ==================== 分类 ====================

model Category {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  parentKey String?  @map("parent_key")
  sortOrder Int      @default(0) @map("sort_order")
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}
