# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=personal_profile

# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=1d

# 邮件发送（SMTP）：注册验证码 / 密码找回
# HOST/PORT/USER/PASS：SMTP 服务器与账号（465 为 SSL，587 为 STARTTLS）
# FROM：发件人展示，如 "墨堆 <noreply@inkheap.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=墨堆 <noreply@inkheap.com>

# 每次启动服务器后清空大模型列表，提高大模型Key安全性
RESET_MODEL=true